# Docker Compose settings. Copy this file to .env before running compose.
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CACHE_TTL_SECONDS=86400
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Leave empty for the bundled nginx proxy (same-origin /api and /health).
# For a separately hosted frontend, set this at frontend build time instead.
VITE_API_URL=
