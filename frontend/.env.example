# Base URL of the FastAPI backend, without a trailing slash or /api suffix.
# Local development:
VITE_API_URL=http://localhost:8000

# Production options:
# - Same-origin nginx/Docker deployment: leave empty (the frontend calls /api and /health).
# - Vercel/static frontend with Render backend: use the backend origin, for example
#   VITE_API_URL=https://windsight-api.onrender.com
